# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Kaggle has two credential systems. Use EITHER one.
#
# 1. API token (preferred). kaggle.com/settings -> API -> "Generate New Token".
#    Copy the whole string exactly as displayed, including the short prefix
#    before the underscore. Requires kaggle >= 1.8.0.
KAGGLE_API_TOKEN=

# 2. Legacy key. Same page -> "Create Legacy API Key", which downloads a
#    kaggle.json containing {"username": ..., "key": ...}. Only needed if you
#    are not using the token above.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Competition slug, from its URL: kaggle.com/competitions/<THIS-PART>
KAGGLE_COMPETITION=bt-4012-competition-2026
