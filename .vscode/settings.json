{
  // Point VS Code and the Jupyter extension at the project venv so the
  // notebook picks the right kernel without being asked.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  // Matplotlib cannot write to the default ~/.matplotlib on this machine.
  "terminal.integrated.env.osx": {
    "MPLCONFIGDIR": "${workspaceFolder}/.cache/matplotlib"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  }
}
